// Prisma 5: عميل PostgreSQL تقليدي — يكفي تعيين DATABASE_URL في البيئة (مثلاً Neon أو Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// مستخدم التطبيق: بريد + كلمة مرور مشفّرة + مصفوفة الدروس كـ JSON (متوافق مع واجهة التطبيق الحالية)
model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String
  lessons            Json
  calendarEvents     Json          @default("[]")
  /// ملف تعلّم المستخدم الذي يبنيه الذكاء (JSON منظم — يُصدَّر MD للأدمن)
  aiLearningProfile  Json          @default("{}")
  /// مفتاح Gemini API مشفّر (AES-256-GCM) — اختياري
  geminiApiKeyEnc    String?
  /// آخر 4 أحرف من المفتاح للعرض فقط (مثل abcd)
  geminiKeyHint      String?
  geminiKeyUpdatedAt DateTime?
  isAdmin            Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lessonShares    LessonShare[]
}

/// رابط مشاركة درس: صلاحية قراءة/تعديل + إمكانية النسخ
model LessonShare {
  id         String   @id @default(uuid())
  ownerId    String
  lessonId   String
  token      String   @unique
  permission String   @default("read")
  allowCopy  Boolean  @default(true)
  active     Boolean  @default(true)
  scope      Json?
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, lessonId])
  @@index([token])
}
