# Secret for signing session cookies (min 16 characters). Required for stable sessions in production.
AUTH_SECRET=

# حساب مدير يُنشأ/يُحدَّث تلقائياً عند تشغيل الخادم (اختياري — 8 أحرف على الأقل لكلمة المرور)
# لا تستخدم بريداً مسجّلاً لمستخدم عادي؛ إن وُجد حساب عادي بنفس البريد لن يُرقّى.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL connection (Neon, Supabase, Railway, Render, etc.)
# Supabase: Settings → Database → Connection string (URI) أو فقط كلمة المرور:
SUPABASE_DB_PASSWORD=
# DATABASE_URL should point to the connection pooler (e.g. port 6543 on Supabase / PgBouncer).
# This is used by the Prisma client at runtime for all queries.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=
# DIRECT_URL bypasses the pooler and is used only by Prisma for migrations/introspection.
# Set this to the direct (non-pooled) connection string (e.g. port 5432).
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=

# Supabase — عميل JavaScript (واجهة، تخزين، Realtime، إلخ)
# من: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# إما Publishable الجديد أو Anon (JWT) الكلاسيكي
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL for share links (required in production if you access the app via localhost tunnel)
# Example: https://drosi.up.railway.app
NEXT_PUBLIC_APP_URL=

# Optional: server-wide AI fallback (OpenRouter) when users have no personal Gemini key
OPENROUTER_API_KEY=
# Users can connect their own free Gemini API key in Settings (stored encrypted per account)

# Playwright E2E (or reuse ADMIN_EMAIL / ADMIN_PASSWORD)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_TEST_EMAIL=
# PLAYWRIGHT_TEST_PASSWORD=
