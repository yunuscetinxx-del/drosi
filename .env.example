# Secret for signing session cookies (min 16 characters). Required for stable sessions in production.
AUTH_SECRET=

# حساب مدير يُنشأ/يُحدَّث تلقائياً عند تشغيل الخادم (اختياري — 8 أحرف على الأقل لكلمة المرور)
# لا تستخدم بريداً مسجّلاً لمستخدم عادي؛ إن وُجد حساب عادي بنفس البريد لن يُرقّى.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL connection (Neon, Supabase, Railway, Render, etc.)
# Supabase: Settings → Database → Connection string (URI) أو فقط كلمة المرور:
SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=

# Supabase — عميل JavaScript (واجهة، تخزين، Realtime، إلخ)
# من: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# إما Publishable الجديد أو Anon (JWT) الكلاسيكي
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL for share links (required in production if you access the app via localhost tunnel)
# Example: https://drosi-production.up.railway.app
NEXT_PUBLIC_APP_URL=

# Optional: OpenRouter for AI features
OPENROUTER_API_KEY=

# Playwright E2E (or reuse ADMIN_EMAIL / ADMIN_PASSWORD)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_TEST_EMAIL=
# PLAYWRIGHT_TEST_PASSWORD=
